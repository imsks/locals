# LM Studio (OpenAI-compatible local server)
# Start the server in LM Studio → Local Server → Start Server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Must match the loaded model id — verify with: curl http://localhost:1234/v1/models
LMSTUDIO_MODEL=google/gemma-4-26b-a4b-qat
LMSTUDIO_REQUEST_TIMEOUT=300
LMSTUDIO_MAX_COMPLETION_TOKENS=4096
# LM Studio often parses JSON from message content better than strict response_format
LMSTUDIO_ADD_SCHEMA_TO_SYSTEM_PROMPT=true
LMSTUDIO_DONT_FORCE_STRUCTURED_OUTPUT=true

# Agent limits — local 26B models need longer timeouts than browser-use defaults (75s)
AGENT_MAX_STEPS=15
AGENT_LLM_TIMEOUT=300
AGENT_STEP_TIMEOUT=300
AGENT_ENABLE_PLANNING=false
AGENT_FLASH_MODE=true
AGENT_USE_THINKING=false
AGENT_USE_JUDGE=false
AGENT_MAX_ACTIONS_PER_STEP=1
AGENT_MAX_CLICKABLE_ELEMENTS_LENGTH=8000
# Vision sends screenshots each step — very slow locally; keep false unless needed
AGENT_USE_VISION=false

# API
API_HOST=0.0.0.0
API_PORT=8080
